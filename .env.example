APP_NAME="Go Germany Tours"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (XAMPP defaults) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_germany_tours
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# sync locally; in production use "database" and run a worker (see docs/reference/DEPLOYMENT.md)
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Mail: log driver locally (see storage/logs/laravel.log). Mailpit: MAIL_MAILER=smtp, host 127.0.0.1, port 1025 ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gogermanytours.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin seed account (used by php artisan db:seed only) ---
ADMIN_SEED_NAME="Site Admin"
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- reCAPTCHA v2 checkbox. These are Google's PUBLISHED TEST keys: they always pass. Replace in production
#     (or set real keys in Admin > Site settings, which override these). ---
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- GoHighLevel. Leave BOTH empty to switch the integration off. Never commit real values. ---
GHL_API_TOKEN=
GHL_LOCATION_ID=
